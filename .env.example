NODE_ENV=development
PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/yemden_task_management
JWT_SECRET=replace_with_a_long_random_secret_before_production
JWT_EXPIRES_IN=7d
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
APP_URL=https://march-depth-abreast.ngrok-free.dev/#/login?from=/dashboard

# Optional: configure SMTP to email login details when an admin creates a user.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Yemden Task Management <no-reply@example.com>"

# Optional: required for Firebase push delivery on non-Google hosts.
# If the backend runs on Cloud Run, Firebase App Hosting, App Engine, or Cloud
# Functions, the server can use Application Default Credentials without a key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
